#extend("index"):
#export("view"):
<script src="/Download.js"></script>
<div class="container">
  <button
    id="button"
    type="button"
    onclick="downloadFile('#(filename)')"
    class="btn btn-lg px-4 px-sm-5 rounded-3 border"
    style="background-color: #8efa00"
    >
    <div class="fs-4 fw-medium">DOWNLOAD</div>
  </button>
  <div id="statusMessage" class="mt-2 mx-2 text-info text-break"><strong>#(filename)</strong></div>
</div>
#extend("progress"): #endextend
<div class="container">
  <div id="info" class="h6 lh-base" style="color: #fffb00">
    Tap above to download file from Fly app 👆
    <div class="mt-2 lh-lg" style="color: #8efa00;">
      For background download, use this 👇<br/>
      <a href="/#(filename)" class="link-warning link-offset-2 link-underline-warning">DIRECT LINK</a>
    </div>
  </div>
  <div id="note" style="color: #ff2d55;">
    <div class="strong mt-4">NOTE:</div>
    <div class="small mt-1">
      - To avoid interruption, open this link in a proper browser.
    </div>
    <div class="small mt-1">
      - Please ignore HTTPS warnings, since it's not possible to generate local SSL.
    </div>
  </div>
</div>
#endexport
#endextend

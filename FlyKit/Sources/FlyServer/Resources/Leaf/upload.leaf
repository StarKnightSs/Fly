#extend("index"):
#export("view"):
<script src="/Upload.js"></script>
<div class="container">
  <input
  type="file"
  name="file"
  id="input"
  hidden
  onchange="uploadFile()"
  />
  <button
    id="button"
    type="button"
    onclick="openFileInput()"
    class="btn btn-lg px-4 px-sm-5 rounded-3 border"
    style="background-color: #8efa00"
    >
    <div class="fs-4 fw-medium">UPLOAD</div>
  </button>
  <div id="statusMessage" class="text-info mt-2" hidden></div>
</div>
#extend("progress"): #endextend
<div class="container">
  <div id="info" class="mx-2 h6" style="color: #fffb00">
    Tap the button above to send file to Fly Server 👆
  </div>
  <div id="note" class="fs-6 mt-2" style="color: #ff2d55">
    Tip: To send multiple files, ZIP them up.
  </div>
</div>
#endexport
#endextend

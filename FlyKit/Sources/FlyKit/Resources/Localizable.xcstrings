    "scan_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HINWEIS: Bitte halten Sie die App aktiv und stellen Sie sicher, dass beide Geräte während des Dateiübertrags mit demselben WiFi- oder Hotspot-Netzwerk verbunden sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOTE: Please keep the app active & make sure that both devices are connected on the same wifi or hotspot network during file transfer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOTA: Por favor, mantén la app activa y asegúrate de que ambos dispositivos estén conectados a la misma red wifi o hotspot durante la transferencia de archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "REMARQUE: Veuillez garder l'application active et vous assurer que les deux appareils sont connectés sur le même réseau wifi ou hotspot pendant le transfert de fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOTA: Per favore, mantieni l'app attiva e assicurati che entrambi i dispositivi siano collegati alla stessa rete wifi o hotspot durante il trasferimento dei file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注: ファイル転送中はアプリをアクティブに保ち、両方のデバイスが同じWiFiまたはホットスポットネットワークに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 파일 전송 중 앱을 활성 상태로 유지하고 두 기기가 동일한 WiFi 또는 핫스팟 네트워크에 연결되어 있는지 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ПРИМЕЧАНИЕ: Пожалуйста, держите приложение активным и убедитесь, что оба устройства подключены к одной сети WiFi или Hotspot во время передачи файлов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LƯU Ý: Vui lòng giữ ứng dụng hoạt động & đảm bảo rằng cả hai thiết bị đều được kết nối trên cùng một mạng wifi hoặc hotspot trong quá trình chuyển tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：文件传输过程中请保持应用活跃，并确保两台设备连接在同一个wifi或热点网络上。"
          }
        }
      }
    },
